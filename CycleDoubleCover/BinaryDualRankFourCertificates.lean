/-- Five covector words, packed in successive four-bit blocks. -/
def binaryFourCoverCode (m : Fin 2048) (i : Fin 5) : Nat :=
  (binaryFourCoverTable.getD m.val 0 / 16 ^ i.val) % 16

/-- Odd scalar pairing of two four-bit words. -/
def binaryFourCodeDot (a x : Nat) : Bool :=
  let z := Nat.land a x
  (z.testBit 0 != z.testBit 1) != (z.testBit 2 != z.testBit 3)

/-- Exact incidence count of the five certified covectors. -/
def binaryFourCodeCoverCount (m : Fin 2048) (x : Fin 16) : Nat :=
  ∑ i : Fin 5, if binaryFourCodeDot (binaryFourCoverCode m i) x.val then 1 else 0

set_option maxRecDepth 100000 in
set_option maxHeartbeats 0 in
-- Exhaustive kernel evaluation of 2,048 grounds exceeds the default heartbeat budget.
/-- The finite certificate covers every original occupied column exactly twice.
This checks all 2,048 normalized grounds inside the Lean kernel. -/
theorem binary_four_code_cover_certificate : ∀ m : Fin 2048,
    binaryFourCodeNoFano m = true → ∀ x : Fin 16,
      binaryFourCodeMem m x.val = true → binaryFourCodeCoverCount m x = 2 := by
  decide +kernel

end CycleDoubleCover.MatroidPaper
