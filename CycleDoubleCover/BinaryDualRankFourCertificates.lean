import CycleDoubleCover.BinaryRankFourZeroSumNormalForms
import CycleDoubleCover.RankThreeMatroidCovers

/-! Kernel-checked covector certificates for all normalized four-row binary
column grounds. Eleven membership bits encode the points outside an actual
basis. No native evaluation or extra axiom is used. The affine-coset condition
is subsequently related to an actual Fano contraction, rather than assumed
as a matroid structure theorem. -/

namespace CycleDoubleCover.MatroidPaper

open Matrix

/-- Membership of a nonzero binary point in a normalized ground. -/
def binaryFourCodeMem (m : Fin 2048) (x : Nat) : Bool :=
  match x with
  | 1 | 2 | 4 | 8 => true
  | 3 => m.val.testBit 0
  | 5 => m.val.testBit 1
  | 6 => m.val.testBit 2
  | 7 => m.val.testBit 3
  | 9 => m.val.testBit 4
  | 10 => m.val.testBit 5
  | 11 => m.val.testBit 6
  | 12 => m.val.testBit 7
  | 13 => m.val.testBit 8
  | 14 => m.val.testBit 9
  | 15 => m.val.testBit 10
  | _ => false

/-- Each occupied contraction direction leaves one quotient point missing. -/
def binaryFourCodeNoFano (m : Fin 2048) : Bool :=
  (List.range 16).all fun a => !binaryFourCodeMem m a ||
    (List.range 16).any fun x => x != 0 && x != a &&
      !binaryFourCodeMem m x && !binaryFourCodeMem m (Nat.xor x a)

